# All optional for a local demo. Copy to server/.env and fill what you have.
PORT=5001
NODE_ENV=development

# MongoDB (Atlas or local). Empty = embedded MongoDB stored in server/.localdb
MONGODB_URI=
# Force the embedded database even when MONGODB_URI is set
USE_LOCAL_DB=false
# Set to false to skip demo accounts/grievances on an empty database
SEED_DEMO_DATA=true

# Empty = a secret is generated once into server/.jwt-secret
JWT_SECRET=
JWT_EXPIRY=24h

# Google Gemini: AI priority analysis + Smart Query. Empty = offline rules
GEMINI_API_KEY=

# Stream Chat (petitioner <-> official chat). Empty = chat disabled
STREAM_API_KEY=
STREAM_API_SECRET=

# Supabase Auth (optional; local JWT login is used without it)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extra allowed browser origins, comma separated (e.g. http://192.168.1.10:3000)
CORS_ORIGINS=
